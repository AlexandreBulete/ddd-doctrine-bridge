{
    "name": "alexandrebulete/ddd-doctrine-bridge",
    "description": "Doctrine ORM bridge for DDD Foundation - Pure PHP, no framework dependency",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandre Bulete"
        }
    ],
    "require": {
        "php": "^8.2",
        "alexandrebulete/ddd-foundation": "^1.2",
        "doctrine/orm": "^3.6 || ^4.0",
        "doctrine/dbal": "^3.10 || ^4.0",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/cache": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "AlexandreBulete\\DddDoctrineBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexandreBulete\\DddDoctrineBridge\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "qa": [
            "@phpstan",
            "@test"
        ]
    }
}
